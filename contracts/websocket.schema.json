{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:looki:contracts:websocket:1.0",
  "title": "LOOKi WebSocket v1",
  "description": "Un message JSON texte par frame WebSocket. Authentification Bearer à la connexion. Voir README pour les garanties et curseurs.",
  "$defs": {
    "clientMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "question"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          },
          "required": [
            "type",
            "request_id",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ping"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "serverEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "type": {
              "const": "session.state"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "closed"
                  ]
                },
                "center_id": {
                  "type": "string"
                },
                "vision_provider": {
                  "enum": [
                    "mock",
                    "depth_anything_metric",
                    "urban_objects",
                    "yolo_objects",
                    "yolo_seg_track"
                  ]
                }
              },
              "required": [
                "status",
                "center_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "frame.analyzed"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "provider": {
                  "type": "string"
                },
                "simulated": {
                  "type": "boolean"
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "text": {
                  "type": "string"
                },
                "detections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/detection"
                  }
                },
                "latency_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "timing_ms": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "metadata": {
                  "type": "object"
                }
              },
              "required": [
                "frame_id",
                "provider",
                "simulated",
                "captured_at",
                "text",
                "detections",
                "latency_ms"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "alert.proximity"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "provider": {
                  "type": "string"
                },
                "simulated": {
                  "type": "boolean"
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "text": {
                  "type": "string"
                },
                "severity": {
                  "const": "warning"
                },
                "threshold_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "nearest_distance_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "detections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/detection"
                  }
                }
              },
              "required": [
                "frame_id",
                "provider",
                "simulated",
                "captured_at",
                "text",
                "severity",
                "threshold_m",
                "nearest_distance_m",
                "detections"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "answer"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "question": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "mode": {
                  "const": "observations_only"
                },
                "center_id": {
                  "type": "string"
                },
                "center_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "frame_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "simulated": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "request_id",
                "question",
                "text",
                "mode",
                "center_id",
                "center_name",
                "frame_id",
                "simulated"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "analysis.failed"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "code": {
                  "enum": [
                    "stale_frame",
                    "inference_failed",
                    "superseded_frame"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "frame_id",
                "code",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "null"
            },
            "type": {
              "const": "pong"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "null"
            },
            "type": {
              "const": "error"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "alert.possible_proximity"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "provider": {
                  "type": "string"
                },
                "simulated": {
                  "type": "boolean"
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "text": {
                  "type": "string"
                },
                "severity": {
                  "const": "warning"
                },
                "detections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/detection"
                  }
                },
                "ruleset": {
                  "enum": [
                    "person-visual-v2",
                    "person-visual-v3",
                    "urban-visual-v4"
                  ]
                }
              },
              "required": [
                "frame_id",
                "provider",
                "simulated",
                "captured_at",
                "text",
                "severity",
                "detections",
                "ruleset"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "frame.depth_analyzed"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "provider": {
                  "type": "string"
                },
                "simulated": {
                  "type": "boolean"
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "text": {
                  "type": "string"
                },
                "detections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/detection"
                  }
                },
                "timing_ms": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "metadata": {
                  "type": "object"
                }
              },
              "required": [
                "frame_id",
                "provider",
                "simulated",
                "captured_at",
                "text",
                "detections"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "depth.failed"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "payload": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "code": {
                  "enum": [
                    "stale_depth",
                    "depth_inference_failed"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "provider": {
                  "const": "yolo_seg_track"
                },
                "simulated": {
                  "const": false
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "frame_id",
                "code",
                "text",
                "provider",
                "simulated",
                "captured_at"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "session_id",
            "timestamp",
            "payload"
          ],
          "additionalProperties": false
        }
      ]
    },
    "detection": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "distance_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "distance_source": {
          "enum": [
            "simulated",
            "metric_model"
          ]
        },
        "proximity": {
          "enum": [
            "near",
            "medium",
            "far",
            "unknown"
          ]
        },
        "observation_type": {
          "enum": [
            "region",
            "object"
          ],
          "description": "Absent on historical events: region."
        },
        "depth_valid_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "perception": {
          "type": "object",
          "description": "Masques normalisés, identifiant de suivi, risque et indices. Vide pour les anciens providers.",
          "properties": {
            "polygons": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "mask_area_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mask_edges": {
              "type": "array",
              "items": {
                "enum": [
                  "left",
                  "right",
                  "bottom",
                  "top"
                ]
              }
            },
            "track_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "track_observations": {
              "type": "integer",
              "minimum": 0
            },
            "risk": {
              "enum": [
                "metric_near",
                "possible",
                "not_flagged",
                "approaching"
              ]
            },
            "distance_quality": {
              "enum": [
                "estimated",
                "uncertain",
                "unavailable"
              ]
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "object"
            },
            "motion": {
              "enum": [
                "approaching",
                "receding",
                "stable",
                "unknown"
              ]
            },
            "alert_emitted": {
              "type": "boolean"
            },
            "detection_status": {
              "enum": [
                "tentative",
                "confident",
                "tracked"
              ]
            },
            "visual_profile": {
              "enum": [
                "person",
                "bicycle",
                "car",
                null
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "label",
        "confidence",
        "bbox",
        "distance_m",
        "distance_source",
        "proximity"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/clientMessage"
    },
    {
      "$ref": "#/$defs/serverEvent"
    }
  ]
}
