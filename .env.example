# Valeurs de développement uniquement. Copier vers .env pour les remplacer.
LOOKI_API_KEY=looki-local-dev-key
POSTGRES_DB=looki
POSTGRES_USER=looki
POSTGRES_PASSWORD=looki-local-password
BACKEND_PORT=8000
LOOKI_VISION_PROVIDER=mock
# Moteur de profondeur pour urban_objects : depth_anything ou unidepth_v2.
LOOKI_DEPTH_BACKEND=depth_anything
# Option UniDepthV2 : JSON de calibration réelle placé dans calibration/.
# Exemple de chemin : /app/calibration/camera.json. Vide = intrinsèques estimées.
LOOKI_CAMERA_CALIBRATION_PATH=
# Vide : modèle par défaut du moteur choisi (indoor pour depth_anything_metric).
LOOKI_DEPTH_MODEL_ID=
LOOKI_OBJECT_MODEL_ID=PekingU/rtdetr_r18vd
LOOKI_OBJECT_CONFIDENCE_THRESHOLD=0.5
LOOKI_VISION_DEVICE=cpu
INSTALL_VISION=false
LOOKI_NEAR_THRESHOLD_M=1.5
LOOKI_FAR_THRESHOLD_M=3.0
LOOKI_MIN_CONFIDENCE=0.5
LOOKI_MAX_PENDING_FRAMES=32
LOOKI_MAX_FRAME_AGE_SECONDS=30
LOOKI_CENTRES_PROVIDER=mock
# LOOKI_CENTRES_BASE_URL=https://centres.example.com
# LOOKI_CENTRES_API_KEY=replace-me
