# Profil équipe : vision réelle sur CPU. Copier vers .env au premier lancement.
# Secrets de développement uniquement ; les remplacer pour un déploiement distant.
LOOKI_API_KEY=looki-local-dev-key
POSTGRES_DB=looki
POSTGRES_USER=looki
POSTGRES_PASSWORD=looki-local-password
BACKEND_PORT=8000
LOOKI_VISION_PROVIDER=yolo_seg_track
# Moteur de profondeur pour urban_objects / yolo_objects / yolo_seg_track : depth_anything ou unidepth_v2.
LOOKI_DEPTH_BACKEND=unidepth_v2
# Option UniDepthV2 : JSON de calibration réelle placé dans calibration/.
# Exemple de chemin : /app/calibration/camera.json. Vide = intrinsèques estimées.
LOOKI_CAMERA_CALIBRATION_PATH=
# Vide : modèle par défaut du moteur choisi (indoor pour depth_anything_metric).
LOOKI_DEPTH_MODEL_ID=
# Utilisé uniquement par urban_objects ; yolo_seg_track charge YOLO26n-seg.
LOOKI_OBJECT_MODEL_ID=PekingU/rtdetr_r18vd
# Entrées YOLO plus sensibles ; alertes nouvelles toujours à >= LOOKI_MIN_CONFIDENCE.
LOOKI_OBJECT_CONFIDENCE_THRESHOLD=0.25
LOOKI_VISION_DEVICE=cpu
# Installe les bibliothèques ML au build. Les poids sont téléchargés au démarrage
# dans le volume looki_model_cache, réutilisé après docker compose down / up.
INSTALL_VISION=true
LOOKI_NEAR_THRESHOLD_M=1.5
LOOKI_FAR_THRESHOLD_M=3.0
LOOKI_MIN_CONFIDENCE=0.5
LOOKI_MAX_PENDING_FRAMES=32
LOOKI_MAX_FRAME_AGE_SECONDS=30
# Contexte métier fictif tant que le backend centres n'est pas branché.
LOOKI_CENTRES_PROVIDER=mock
# LOOKI_CENTRES_BASE_URL=https://centres.example.com
# LOOKI_CENTRES_API_KEY=replace-me

# Profil vidéo testé avec un quota de 4 CPU et 2 threads par modèle.
LOOKI_CPU_THREADS=2
LOOKI_YOLO_IMAGE_SIZE=768
BACKEND_CPUS=4
BACKEND_MEMORY=6g
# Vide : choisir une vidéo locale dans /live/. Pour une vidéo servie par l'API,
# déposer le fichier privé dans media/ et renseigner /app/media/night-walk.mp4.
LOOKI_DEMO_VIDEO_PATH=
# UniDepth : vide = résolution standard ; 0 = niveau officiel le plus léger.
LOOKI_UNIDEPTH_RESOLUTION_LEVEL=0

# yolo_seg_track : deux traitements concurrents sous le quota Compose de 4 CPU.
# Deux threads Torch par modèle ; les mètres restent attachés à leur capture.
LOOKI_DECOUPLED_DEPTH=true
LOOKI_DEPTH_INTERVAL_SECONDS=2
LOOKI_DEPTH_MAX_AGE_SECONDS=3
LOOKI_WORKER_POLL_SECONDS=0.01

# Questions HTTP + audio WebRTC direct. La vision fonctionne sans clé OpenAI.
# Activer explicitement avec une clé projet sur la VM ; aucun mock audio automatique.
LOOKI_REALTIME_ENABLED=false
LOOKI_OPENAI_API_KEY=
LOOKI_REALTIME_MODEL=gpt-realtime-2.1
LOOKI_REALTIME_VOICE=marin
# Effort faible pour les questions courtes ; mesurer avant de relever le budget.
LOOKI_REALTIME_REASONING_EFFORT=low
LOOKI_REALTIME_MAX_OUTPUT_TOKENS=1024
# Espacement des nouvelles questions par session ; les retries exacts restent idempotents.
LOOKI_REALTIME_QUESTION_INTERVAL_SECONDS=2
LOOKI_REALTIME_CONNECT_TIMEOUT_SECONDS=20
LOOKI_REALTIME_GENERATION_TIMEOUT_SECONDS=30
LOOKI_REALTIME_PLAYBACK_TIMEOUT_SECONDS=60
LOOKI_REALTIME_CALL_MAX_SECONDS=900
LOOKI_SCENE_MAX_AGE_SECONDS=3
LOOKI_ALERT_TTL_SECONDS=3
LOOKI_SESSION_TOKEN_TTL_SECONDS=28800
