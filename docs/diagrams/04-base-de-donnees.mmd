%% LOOKi - diagramme détaillé dans ../02-base-de-donnees.md
erDiagram
    sessions ||--o{ realtime_calls : ouvre
    sessions ||--o{ audio_questions : demande
    realtime_calls ||--o{ audio_questions : porte
    sessions ||--o{ frames : recoit
    sessions ||--o{ events : journalise
    frames ||--o{ detections : contient
    frames o|--o{ events : origine
    frames ||--o| depth_jobs : echantillonne
    sessions {
        uuid id PK
        varchar center_id
        varchar user_id "nullable"
        varchar status "active ou closed"
        json context
        timestamptz created_at
        timestamptz closed_at "nullable"
    }
    frames {
        uuid id PK "interne au backend"
        uuid session_id FK
        uuid frame_id "fourni par le Pi"
        timestamptz captured_at
        timestamptz received_at
        timestamptz processed_at "nullable"
        varchar status
        varchar sha256
        varchar content_type "image/jpeg ; PNG historique"
        bytea image
        integer width
        integer height
        varchar provider "nullable"
        boolean simulated "nullable"
        varchar description "nullable"
        varchar error_code "nullable"
        float latency_ms "nullable"
        json timing_ms "durées détaillées"
        json vision_metadata "metadata dans API"
    }
    detections {
        uuid id PK
        uuid frame_id FK "references frames.id"
        varchar label
        float confidence
        json bbox
        float distance_m "nullable"
        varchar distance_source
        varchar proximity
        varchar observation_type "region ou object"
        float depth_valid_fraction "nullable"
        json perception "masques, piste, risque et indices"
    }
    events {
        integer id PK "sequence globale"
        uuid session_id FK
        uuid frame_id FK "nullable, references frames.id"
        varchar type
        timestamptz timestamp
        json payload
        uuid request_id "nullable"
    }
    depth_jobs {
        uuid id PK
        uuid frame_id FK,UK "references frames.id"
        varchar status "pending, processing, completed, failed"
        bytea masks "masques complets compresses"
        json observations "snapshot ordonne"
        json result "nullable, payload metrique"
        varchar error_code "nullable"
        timestamptz created_at
        timestamptz processed_at "nullable"
    }
    realtime_calls {
        uuid id PK
        uuid session_id FK
        uuid request_id "cle de creation"
        integer media_epoch
        varchar control_status
        varchar provider_call_id "interne"
        text sdp_answer "nullable"
        json error
        timestamptz created_at
        timestamptz closed_at "nullable"
    }
    audio_questions {
        uuid id PK
        uuid session_id FK
        uuid call_id FK
        uuid request_id "cle de question"
        integer media_epoch
        varchar status
        varchar media_status
        text text
        uuid context_id "nullable"
        json context "snapshot fige"
        json playback
        text transcript "nullable"
        json error
        timestamptz deadline_at
    }
