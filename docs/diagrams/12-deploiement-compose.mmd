        API --> PG
        Worker --> PG
        PG --> Data[("Volume looki_postgres_data")]
        Vision --> Cache[("Volume looki_model_cache<br/>/home/looki/.cache/huggingface")]
    end
    Calibration["./calibration/ sur l'hôte"] -. "montage lecture seule /app/calibration" .-> Vision
    Models["Dépôt de poids des modèles"] -. "téléchargement initial en mode réel" .-> Cache
    API --> Ready["/health/ready<br/>base + provider + worker"]
