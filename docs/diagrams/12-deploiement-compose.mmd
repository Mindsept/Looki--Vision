flowchart TB
    Client["Client local / scripts"] -->|"HTTP et WS : 127.0.0.1:8000"| API
    Env[".env local<br/>.env.example : mock par défaut"] --> Compose
    Source["Contexte de build : .<br/>Dockerfile + pyproject.toml + uv.lock"] --> Compose
    subgraph Compose["Docker Compose - projet looki"]
        subgraph Backend["Service backend - utilisateur looki"]
            Migration["alembic upgrade head"] --> API["FastAPI / Uvicorn<br/>un seul processus"]
